# Deriv account wiring
DERIV_AUTH_TOKEN=
DERIV_APP_ID=
DERIV_ACCOUNT_ID=

# Select the Deriv Options account returned by the OTP endpoint.
# demo = virtual funds; real = real-money account.
DERIV_ACCOUNT_MODE=demo

# Required additional gate for real-money execution.
# Keep false until the real execution path has been separately verified.
DERIV_LIVE_TRADING_ENABLED=false

# Market-data symbol and websocket timeout
DERIV_SYMBOL=1HZ100V
DERIV_WS_TIMEOUT=12

# Engine remains paper by default.
OPTIONS_MODE=paper
OPTIONS_DRY_RUN=true
OPTIONS_TIMEFRAMES=1,5
OPTIONS_STAKE_1M=0.5
OPTIONS_STAKE_5M=2
OPTIONS_MARTINGALE=false
